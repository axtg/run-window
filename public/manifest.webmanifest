{
  "name": "Run window",
  "short_name": "Run window",
  "description": "The best weather window for a run today and tomorrow.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#F9FAFB",
  "theme_color": "#111827",
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "route",
          "accept": [
            "application/gpx+xml",
            "application/vnd.google-earth.kml+xml",
            "application/xml",
            "text/xml",
            "application/octet-stream",
            ".gpx",
            ".kml"
          ]
        }
      ]
    }
  },
  "icons": [
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ]
}
