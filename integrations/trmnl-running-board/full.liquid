<div class="layout">
  <div class="rb{% if theme == 'dark' %} rb--dark{% endif %}">
    <div class="rb-main">
      <div class="rb-left">
        {% if week %}
          {% if tredict.message and tredict.message != '' %}
            <div class="rb-message title font--bold lg:label--xlarge">{{ tredict.message | escape }}</div>
          {% endif %}
          <div class="rb-title label label--xlarge font--bold lg:label--xxlarge">{{ week.title | escape }}</div>
          <div class="rb-days">
            {% for day in week.days %}
              <div class="rb-day{% if day.today %} rb-day--today{% endif %}">
                <span class="rb-day__label label label--xlarge font--bold lg:label--xxlarge">{{ day.label | escape }}</span>
                <div class="rb-day__items">
                  {% if day.items.size > 0 %}
                    {% for item in day.items %}
                      <span class="rb-item rb-item--{{ item.kind | escape }} description description--xlarge lg:description--xxlarge {% if item.kind == 'done' or item.kind == 'unplanned' %}font--bold{% else %}font--regular{% endif %}" data-clamp="1" data-clamp-lg="2">{{ item.text | escape }}</span>
                    {% endfor %}
                  {% else %}
                    <span class="rb-item description description--xlarge lg:description--xxlarge font--regular" data-clamp="1" data-clamp-lg="2">—</span>
                  {% endif %}
                </div>
                {% if day.more and day.more != '' %}
                  <span class="rb-day__more description description--xlarge font--bold lg:description--xxlarge">{{ day.more | escape }}</span>
                {% endif %}
              </div>
            {% endfor %}
          </div>
          <div class="rb-total title font--bold lg:label--xlarge">{{ week.footer | escape }}</div>
        {% else %}
          <div class="rb-message rb-message--big title font--bold lg:label--xlarge">{{ tredict.message | escape }}</div>
        {% endif %}
      </div>

      <div class="rb-right">
        <div class="rb-form{% if intensity %} rb-form--intensity{% endif %}">
          {% if form %}
            <div class="rb-form__head">
              <span class="rb-form__heading description description--xxlarge font--bold lg:title--large">{{ form.heading | escape }}</span>
              <span class="rb-form__value value value--large font--bold lg:value--xlarge">{{ form.today | escape }}</span>
            </div>
            {% if form.empty and form.empty != '' %}
              <div class="rb-message rb-message--big title font--bold lg:label--xlarge">{{ form.empty | escape }}</div>
            {% else %}
              <div class="rb-form__graphbox">
              <svg class="rb-form__graph" viewBox="0 0 360 150" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                <line class="rb-zero" x1="0" y1="{{ form.zeroY }}" x2="360" y2="{{ form.zeroY }}" stroke="#000" stroke-width="1" shape-rendering="crispEdges" vector-effect="non-scaling-stroke" />
                <line class="rb-today" x1="{{ form.todayX }}" y1="0" x2="{{ form.todayX }}" y2="150" stroke="#000" stroke-width="1" stroke-dasharray="2 4" shape-rendering="crispEdges" vector-effect="non-scaling-stroke" />
                <path class="rb-past" d="{{ form.pastPath }}" fill="none" stroke="#000" stroke-width="3" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
                {% if form.futurePath and form.futurePath != '' %}
                  <path class="rb-future" d="{{ form.futurePath }}" fill="none" stroke="#000" stroke-width="3" stroke-dasharray="8 6" vector-effect="non-scaling-stroke" />
                {% endif %}
              </svg>
              <span class="rb-form__today description description--large font--regular lg:description--xlarge" style="left: {{ form.todayX | divided_by: 3.6 }}%">{{ form.labels.today | escape }}</span>
              </div>
              <div class="rb-form__labels">
                <span class="rb-form__label description description--large font--regular lg:description--xlarge">{{ form.labels.back | escape }}</span>
                <span class="rb-form__label description description--large font--regular lg:description--xlarge">{{ form.labels.ahead | escape }}</span>
              </div>
            {% endif %}
          {% endif %}
          {% if intensity %}
            <div class="rb-intensity">
              {% assign patternId = 'rb-moderate' | append_random %}
              <div class="rb-intensity__heading description description--large font--bold lg:description--xlarge">{{ intensity.heading | escape }}</div>
              <svg class="rb-intensity__bar" viewBox="0 0 360 22" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <pattern id="{{ patternId }}" width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                    <rect width="4" height="4" fill="#fff" />
                    <line x1="1" y1="0" x2="1" y2="4" stroke="#000" stroke-width="2" />
                  </pattern>
                </defs>
                {% for segment in intensity.segments %}
                  {% case segment.kind %}
                    {% when 'high' %}
                      <rect x="{{ segment.x | plus: 0 }}" y="0" width="{{ segment.width | plus: 0 }}" height="22" fill="#000" />
                    {% when 'moderate' %}
                      <rect x="{{ segment.x | plus: 0 }}" y="0" width="{{ segment.width | plus: 0 }}" height="22" fill="url(#{{ patternId }})" />
                    {% else %}
                      <rect x="{{ segment.x | plus: 0 }}" y="0" width="{{ segment.width | plus: 0 }}" height="22" fill="#fff" />
                  {% endcase %}
                {% endfor %}
                <rect x="0" y="0" width="360" height="22" fill="none" stroke="#000" stroke-width="2" vector-effect="non-scaling-stroke" />
              </svg>
              <div class="rb-intensity__labels">
                {% for label in intensity.labels %}
                  <span class="rb-intensity__label description description--large font--regular lg:description--xlarge">{{ label | escape }}</span>
                {% endfor %}
              </div>
            </div>
          {% endif %}
        </div>

        <div class="rb-run">
          <div class="rb-run__heading description description--xxlarge font--bold lg:title--large">{{ run.heading | escape }}</div>
          {% for line in run.lines %}
            <div class="rb-run__line {% if forloop.first %}rb-run__line--first value font--bold lg:value--large{% else %}title font--regular lg:label--xlarge{% endif %}">{{ line | escape }}</div>
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="rb-foot">
      <span class="rb-foot__source description font--regular lg:description--large">{{ attribution | escape }}</span>
      {% if fetchedAtText and fetchedAtText != '' %}
        <span class="rb-foot__time description font--regular lg:description--large">data {{ fetchedAtText | escape }}</span>
      {% endif %}
    </div>
  </div>
</div>
