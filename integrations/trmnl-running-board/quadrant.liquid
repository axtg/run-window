<div class="layout">
  <div class="rb{% if theme == 'dark' %} rb--dark{% endif %}">
    <div class="rb-solo">
      <div class="rb-run rb-run--compact">
        <div class="rb-run__heading title font--bold lg:description--xxlarge">{{ run.heading | escape }}</div>
        {% for line in run.lines %}
          <div class="rb-run__line {% if forloop.first %}rb-run__line--first title title--large font--bold lg:value--base{% else %}description description--large font--regular lg:description--xlarge{% endif %}">{{ line | escape }}</div>
        {% endfor %}
      </div>
    </div>

    <div class="rb-foot">
      <span class="rb-foot__source description font--regular lg:description--large">{{ attribution | escape }}</span>
      {% if fetchedAtText and fetchedAtText != '' %}
        <span class="rb-foot__time description font--regular lg:description--large">data {{ fetchedAtText | escape }}</span>
      {% endif %}
    </div>
  </div>
</div>
