<style>
  .rb { display: flex; flex-direction: column; width: 100%; height: 100%; color: #000; background: #fff; }
  /* The board paints its own black and white, which TRMNL's dark mode can't reach: that only remaps framework colours.
     TRMNL's dark mode is one value for the whole recipe, so the Theme setting gives each install its own choice. */
  .screen--dark-mode .rb, .screen:not(.screen--dark-mode) .rb--dark { filter: invert(1); }
  /* The framework's dark mode recolours its own .title and .value classes; pin them so the invert alone decides */
  .screen .rb .title, .screen .rb .value { color: #000; }
  .rb-main { display: flex; flex: 1 1 auto; min-height: 0; overflow: hidden; }
  .rb-left { display: flex; flex-direction: column; flex: 0 0 45%; min-width: 0; padding-right: 12px; border-right: 2px solid #000; }
  .rb-right { display: flex; flex-direction: column; flex: 1 1 auto; min-width: 0; min-height: 0; overflow: hidden; padding-left: 14px; }
  .rb-title { font-size: 26px; font-weight: 700; line-height: 30px; margin-bottom: 4px; }
  .rb-days { flex: 1 1 auto; display: flex; flex-direction: column; }
  .rb-day { display: flex; align-items: center; flex: 1 1 0; min-height: 0; padding: 0 6px; border-bottom: 1px solid #000; }
  .rb-day--today, .rb-day--today * { background: #000; color: #fff; }
  .rb-day__label { min-width: 42px; flex: 0 0 auto; padding-right: 6px; font-size: 26px; font-weight: 700; }
  .rb-day__items { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; }
  .rb-item { font-size: 19px; line-height: 23px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rb-item--done, .rb-item--unplanned { font-weight: 700; }
  .rb-day__more { flex: 0 0 auto; padding-left: 6px; font-size: 19px; font-weight: 700; }
  .rb-total { font-size: 21px; font-weight: 700; line-height: 26px; padding-top: 4px; }
  .rb-message { font-size: 22px; font-weight: 700; line-height: 28px; padding: 6px 8px; border: 2px solid #000; }
  .rb-message--big { margin-top: 12px; }
  .rb-form { display: flex; flex-direction: column; flex: 1 1 auto; border-bottom: 2px solid #000; padding-bottom: 6px; }
  .rb-form__head { display: flex; justify-content: space-between; align-items: flex-start; }
  .rb-form__heading { font-size: 24px; font-weight: 700; line-height: 30px; }
  .rb-form__value { font-size: 56px; font-weight: 700; line-height: 56px; }
  .rb-form svg { display: block; width: 100%; height: auto; }
  .rb-form svg.rb-form__graph { height: 160px; }
  .rb-form__labels { display: flex; justify-content: space-between; font-size: 16px; line-height: 20px; }
  .rb-form__graphbox { position: relative; }
  .rb-form__today { position: absolute; bottom: 4px; transform: translateX(-100%); padding-right: 5px; font-size: 16px; line-height: 16px; }
  /* With the bar, the graph takes whatever height the run panel leaves, never under 84px */
  .rb-form--intensity .rb-form__graphbox { flex: 1 1 84px; min-height: 84px; }
  .rb-form--intensity svg.rb-form__graph { position: absolute; top: 0; left: 0; height: 100%; }
  .rb-intensity__heading { font-size: 17px; font-weight: 700; line-height: 21px; padding-top: 4px; }
  .rb-intensity__labels { display: flex; justify-content: space-between; font-size: 15px; line-height: 19px; }
  .rb-run { padding-top: 8px; }
  .rb-run__heading { font-size: 24px; font-weight: 700; line-height: 30px; }
  .rb-run__line { font-size: 22px; line-height: 28px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rb-run__line--first { font-size: 36px; font-weight: 700; line-height: 44px; }
  .rb-foot { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; font-size: 13px; line-height: 16px; padding-top: 4px; }
  .rb-foot__source { flex: 1 1 auto; min-width: 0; white-space: normal; overflow-wrap: anywhere; }
  .rb-foot__time { flex: 0 0 auto; white-space: nowrap; }
  /* Smaller layouts: one column (half vertical, quadrant); a graph that fills its box and ends its column */
  .rb-solo { display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; overflow: hidden; }
  .rb-form--fill .rb-form__graphbox { flex: 1 1 48px; min-height: 48px; }
  .rb-form--fill svg.rb-form__graph { position: absolute; top: 0; left: 0; height: 100%; }
  .rb-form--last { border-bottom: 0; padding-bottom: 0; }
  .rb-run--compact .rb-run__heading { font-size: 20px; line-height: 24px; }
  .rb-run--compact .rb-run__line { font-size: 18px; line-height: 22px; }
  .rb-run--compact .rb-run__line--first { font-size: 30px; line-height: 36px; }
  .rb-message--small { font-size: 18px; line-height: 22px; padding: 4px 6px; margin-bottom: 4px; }
</style>
