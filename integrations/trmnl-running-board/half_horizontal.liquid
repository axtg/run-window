<div class="layout">
  <div class="rb{% if theme == 'dark' %} rb--dark{% endif %}">
    <div class="rb-main">
      <div class="rb-left">
        <div class="rb-run rb-run--compact">
          <div class="rb-run__heading">{{ run.heading | escape }}</div>
          {% for line in run.lines %}
            <div class="rb-run__line{% if forloop.first %} rb-run__line--first{% endif %}">{{ line | escape }}</div>
          {% endfor %}
        </div>
      </div>

      <div class="rb-right">
        {% if tredict.message and tredict.message != '' %}
          <div class="rb-message rb-message--small">{{ tredict.message | escape }}</div>
        {% endif %}
        <div class="rb-form rb-form--fill rb-form--last">
          {% if form %}
            <div class="rb-form__head">
              <span class="rb-form__heading">{{ form.heading | escape }}</span>
              <span class="rb-form__value value">{{ form.today | escape }}</span>
            </div>
            {% if form.empty and form.empty != '' %}
              <div class="rb-message rb-message--small">{{ form.empty | escape }}</div>
            {% else %}
              <div class="rb-form__graphbox">
                <svg class="rb-form__graph" viewBox="0 0 360 150" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                  <line class="rb-zero" x1="0" y1="{{ form.zeroY }}" x2="360" y2="{{ form.zeroY }}" stroke="#000" stroke-width="1" shape-rendering="crispEdges" vector-effect="non-scaling-stroke" />
                  <line class="rb-today" x1="{{ form.todayX }}" y1="0" x2="{{ form.todayX }}" y2="150" stroke="#000" stroke-width="1" stroke-dasharray="2 4" shape-rendering="crispEdges" vector-effect="non-scaling-stroke" />
                  <path class="rb-past" d="{{ form.pastPath }}" fill="none" stroke="#000" stroke-width="3" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
                  {% if form.futurePath and form.futurePath != '' %}
                    <path class="rb-future" d="{{ form.futurePath }}" fill="none" stroke="#000" stroke-width="3" stroke-dasharray="8 6" vector-effect="non-scaling-stroke" />
                  {% endif %}
                </svg>
                <span class="rb-form__today" style="left: {{ form.todayX | divided_by: 3.6 }}%">{{ form.labels.today | escape }}</span>
              </div>
              <div class="rb-form__labels">
                <span>{{ form.labels.back | escape }}</span>
                <span>{{ form.labels.ahead | escape }}</span>
              </div>
            {% endif %}
          {% endif %}
        </div>
      </div>
    </div>

    <div class="rb-foot">
      <span class="rb-foot__source">{{ attribution | escape }}</span>
      {% if fetchedAtText and fetchedAtText != '' %}
        <span class="rb-foot__time">data {{ fetchedAtText | escape }}</span>
      {% endif %}
    </div>
  </div>
</div>
